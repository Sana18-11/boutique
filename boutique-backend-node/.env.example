# Copy to .env and fill in. Never commit the real .env.

PORT=5000

# Neon: pooled URL for the app, direct URL (host without "-pooler") for migrations
DATABASE_URL=postgresql://USER:PASSWORD@HOST-pooler.REGION.aws.neon.tech/DB?sslmode=verify-full
DIRECT_URL=postgresql://USER:PASSWORD@HOST.REGION.aws.neon.tech/DB?sslmode=verify-full

# Long random string (e.g. `node -e "console.log(require('crypto').randomBytes(64).toString('hex'))"`)
JWT_SECRET=

# Production only
# NODE_ENV=production
# CORS_ORIGINS=https://yaale.in,https://www.yaale.in
# TRUST_PROXY=true

# Storefront address, used in email links
FRONTEND_URL=http://localhost:5173

# Email over SMTP (Gmail: smtp.gmail.com, port 465, an App Password)
SMTP_HOST=
SMTP_PORT=465
SMTP_USER=
SMTP_PASS=
MAIL_FROM="Yaale <orders@example.com>"

# Razorpay (test keys start with rzp_test_). Leave empty to keep "payment pending".
RAZORPAY_KEY_ID=
RAZORPAY_KEY_SECRET=
# Webhook: <backend>/api/payments/razorpay/webhook, events payment.captured
RAZORPAY_WEBHOOK_SECRET=

# Only for the one-off Laravel → Postgres data migration scripts
# MYSQL_HOST= MYSQL_PORT= MYSQL_USER= MYSQL_PASSWORD= MYSQL_DATABASE=
